<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Интернет для API/WS -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Геолокация (foreground). Android 12+ сам спросит точность -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Геолокация в фоне (ОПЦИОНАЛЬНО, если реально нужна) -->
    <!-- УДАЛИ, если не используешь фоновый трекинг -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground Service для стабильного фонового трекинга (SDK 28+/34+) -->
    <!-- Если фона нет — можно оставить, не мешает -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Android 13+ (SDK 33): если показываешь постоянное уведомление у сервиса -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- (необязательно) заявить фичи, чтобы Play не требовал обязательного GPS -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <application
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true"
        android:label="ISS.AI"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name="kz.iss.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Тема до инициализации Flutter -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ForegroundService для фонового трекинга (если используешь) -->
        <!-- Если не используешь — можешь удалить весь блок <service> -->
        <service
            android:name=".LocationForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Flutter tooling -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Package visibility — оставляем как есть -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
